<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#102a43" />
    <meta name="description" content="EventHub makes it easy to discover events, manage registrations, and organize memorable experiences." />

    <title>@ViewData["Title"] - EventHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons: pencil, trash, calendar, and other interface icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventHub.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg eventhub-navbar">
            <div class="container">
                <a class="navbar-brand eventhub-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="EventHub home">

                    <span class="brand-mark" aria-hidden="true">E</span>

                    <span class="brand-name">
                        Event<span>Hub</span>
                    </span>
                </a>

                <button class="navbar-toggler eventhub-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#eventHubNavigation"
                        aria-controls="eventHubNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="eventHubNavigation">

                    <ul class="navbar-nav mx-lg-auto mb-3 mb-lg-0 eventhub-nav">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Events"
                               asp-action="Index">
                                Explore Events
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            @if (User.IsInRole("Organizer") ||
                                 User.IsInRole("Attendee"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-area=""
                                       asp-controller="Events"
                                       asp-action="MyEvents">
                                        My Events
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="eventhub-account">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="welcome-message">
                                <span class="welcome-dot" aria-hidden="true"></span>
                                Hi, @(User.Identity.Name ?? "there")
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-nav-outline">
                                    Sign out
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-nav-login"
                               asp-controller="Account"
                               asp-action="Login">
                                Log in
                            </a>

                            <a class="btn btn-brand"
                               asp-controller="Account"
                               asp-action="Register">
                                Get started
                                <span aria-hidden="true">&rarr;</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="site-main" role="main">
        <div class="container page-container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <a class="footer-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Event<span>Hub</span>
                </a>

                <p class="footer-description">
                    Discover events. Bring people together.
                </p>

                <div class="footer-bottom">
                    <span>
                        &copy; @DateTime.Now.Year EventHub. All rights reserved.
                    </span>

                    <span class="footer-tagline">
                        Made for meaningful experiences.
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
