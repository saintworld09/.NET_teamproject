@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">EventHub Dashboard</h1>
    <p class="lead">
        Manage your events and keep track of your event registrations.
    </p>
</div>

<div class="row g-4">

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <h5 class="card-title">My Events</h5>
                <h2 class="display-6 fw-bold">0</h2>
                <p class="text-muted">
                    Events you have created.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <h5 class="card-title">Registered Events</h5>
                <h2 class="display-6 fw-bold">0</h2>
                <p class="text-muted">
                    Events you have registered for.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <h5 class="card-title">Upcoming Events</h5>
                <h2 class="display-6 fw-bold">0</h2>
                <p class="text-muted">
                    Events coming up soon.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body">
                <h5 class="card-title">Attendees</h5>
                <h2 class="display-6 fw-bold">0</h2>
                <p class="text-muted">
                    Attendees registered for your events.
                </p>
            </div>
        </div>
    </div>

</div>

<div class="text-center mt-5">
    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-dark">
        Browse Events
    </a>
</div>