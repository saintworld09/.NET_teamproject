
@model EventHub.Models.Event

@{
    ViewData["Title"] = "Delete Event";

    int registrationCount = Model.Registrations?.Count ?? 0;
    bool hasRegistrations = registrationCount > 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h1 class="h3 fw-bold text-danger mb-3">
                        Delete Event
                    </h1>

                    @if (hasRegistrations)
                    {
                        <div class="alert alert-warning" role="alert">
                            <strong>This event cannot be deleted.</strong>
                            It has @registrationCount registration(s).
                            Existing registration records must be preserved.
                            If the event will no longer take place, use
                            <strong>Cancel Event</strong> from the My Events page.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>Warning:</strong>
                            Are you sure you want to permanently delete this event?
                            This action cannot be undone.
                        </div>
                    }

                    <hr />

                    <h2 class="h5 fw-bold">@Model.Title</h2>

                    <p class="text-muted mb-2">
                        <strong>Date:</strong>
                        @Model.EventDate.ToString("dd MMM yyyy, h:mm tt")
                    </p>

                    <p class="text-muted mb-2">
                        <strong>Location:</strong>
                        @Model.Location
                    </p>

                    <p class="text-muted mb-2">
                        <strong>Category:</strong>
                        @(Model.Category?.Name ?? "Uncategorized")
                    </p>

                    <p class="text-muted mb-3">
                        <strong>Status:</strong>
                        @Model.Status
                    </p>

                    <form asp-controller="Events"
                          asp-action="Delete"
                          asp-route-id="@Model.EventId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger"
                                disabled="@hasRegistrations">
                            Delete Event
                        </button>

                        <a asp-controller="Events"
                           asp-action="MyEvents"
                           class="btn btn-outline-secondary ms-2">
                            Back to My Events
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>