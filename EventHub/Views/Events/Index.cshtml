
@model IEnumerable<EventHub.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-5">
    <div>
        <h1 class="display-5 fw-bold">Explore Events</h1>

        <p class="lead mb-0">
            Discover events, learn new things, meet people, and find activities
            that interest you.
        </p>
    </div>

    @if (User.IsInRole("Organizer"))
    {
        <a asp-controller="Events"
           asp-action="Create"
           class="btn btn-dark">
            Create Event
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show"
         role="alert">
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="row g-4">

        @foreach (var eventItem in Model)
        {
            int registeredCount = eventItem.Registrations?
                .Count(r => r.Status == "Registered") ?? 0;

            int remainingPlaces = Math.Max(
                0,
                eventItem.Capacity - registeredCount);

            bool isCancelled = eventItem.Status == "Cancelled";
            bool hasPassed = eventItem.EventDate <= DateTime.Now;
            bool isFull = registeredCount >= eventItem.Capacity;

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body d-flex flex-column">

                        <!-- Category and event status -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

                            <span class="badge bg-dark">
                                @(eventItem.Category?.Name ?? "Uncategorized")
                            </span>

                            @if (isCancelled)
                            {
                                <span class="badge bg-danger">
                                    Cancelled
                                </span>
                            }
                            else if (hasPassed)
                            {
                                <span class="badge bg-secondary">
                                    Past Event
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Scheduled
                                </span>
                            }

                        </div>

                        <!-- Event title and description -->
                        <h5 class="card-title fw-bold">
                            @eventItem.Title
                        </h5>

                        <p class="card-text text-muted">
                            @eventItem.Description
                        </p>

                        <div class="mt-auto">

                            <!-- Event date -->
                            <p class="mb-2">
                                <strong>Date:</strong>
                                @eventItem.EventDate.ToString("dd MMM yyyy, h:mm tt")
                            </p>

                            <!-- Event location -->
                            <p class="mb-2">
                                <strong>Location:</strong>
                                @eventItem.Location
                            </p>

                            <!-- Registration information -->
                            <p class="mb-2">
                                <strong>Capacity:</strong>
                                @eventItem.Capacity attendees
                            </p>

                            <p class="mb-3">
                                <strong>Registered:</strong>
                                @registeredCount

                                <span class="text-muted">
                                    / @eventItem.Capacity
                                </span>
                            </p>

                            <!-- Remaining places -->
                            @if (isCancelled)
                            {
                                <div class="alert alert-danger py-2 small"
                                     role="alert">
                                    This event has been cancelled.
                                    Registration is unavailable.
                                </div>
                            }
                            else if (hasPassed)
                            {
                                <div class="alert alert-secondary py-2 small"
                                     role="alert">
                                    This event has already started or passed.
                                    Registration is closed.
                                </div>
                            }
                            else if (isFull)
                            {
                                <div class="alert alert-warning py-2 small"
                                     role="alert">
                                    This event is fully booked.
                                    No places remain.
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light border py-2 small"
                                     role="status">
                                    <strong>@remainingPlaces</strong>
                                    @(remainingPlaces == 1 ? "place" : "places")
                                    remaining.
                                </div>
                            }

                            <!-- Organizer -->
                            <p class="mb-3 text-muted">
                                <strong>Organizer:</strong>

                                @if (eventItem.Organizer != null)
                                {
                                    @($"{eventItem.Organizer.FirstName} {eventItem.Organizer.LastName}")
                                }
                                else
                                {
                                    <span>Unknown organizer</span>
                                }
                            </p>

                            <!-- Event details button -->
                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@eventItem.EventId"
                               class="btn btn-dark w-100">
                                View Details
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <h3 class="fw-bold">No Events Available Yet</h3>

        <p class="text-muted mt-3">
            There are no events to display right now.
            Check back later to discover upcoming events.
        </p>

        @if (User.IsInRole("Organizer"))
        {
            <a asp-controller="Events"
               asp-action="Create"
               class="btn btn-dark mt-2">
                Create Your First Event
            </a>
        }
    </div>
}