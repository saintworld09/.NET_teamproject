@{
    ViewData["Title"] = "Events";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Explore Events</h1>
    <p class="lead">
        Discover events happening around you and find something you would like to attend.
    </p>
</div>

<div class="row g-4">

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Technology Conference</h5>
                <p class="card-text">
                    Learn about the latest developments in technology and connect with other technology enthusiasts.
                </p>

                <p class="mb-1">
                    <strong>Date:</strong> Coming soon
                </p>

                <p class="mb-3">
                    <strong>Location:</strong> Coming soon
                </p>

                <a href="#" class="btn btn-dark">View Details</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Business Workshop</h5>
                <p class="card-text">
                    Develop practical business skills and learn from experienced professionals.
                </p>

                <p class="mb-1">
                    <strong>Date:</strong> Coming soon
                </p>

                <p class="mb-3">
                    <strong>Location:</strong> Coming soon
                </p>

                <a href="#" class="btn btn-dark">View Details</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Community Event</h5>
                <p class="card-text">
                    Join members of the community for an upcoming event and connect with others.
                </p>

                <p class="mb-1">
                    <strong>Date:</strong> Coming soon
                </p>

                <p class="mb-3">
                    <strong>Location:</strong> Coming soon
                </p>

                <a href="#" class="btn btn-dark">View Details</a>
            </div>
        </div>
    </div>

</div>