
@model IEnumerable<EventHub.Models.Event>

@{
    ViewData["Title"] = "Explore Events";

    var eventList = Model?.ToList() ?? new List<EventHub.Models.Event>();

    string searchTerm = ViewBag.SearchTerm as string ?? string.Empty;
    string selectedStatus = ViewBag.SelectedStatus as string ?? "all";
    string selectedSort = ViewBag.SelectedSort as string ?? "date-asc";

    int resultCount = ViewBag.ResultCount is int count
        ? count
        : eventList.Count;

    int totalEvents = ViewBag.TotalEvents is int total
        ? total
        : eventList.Count;
}

<section class="events-page">

    <!-- Page header -->
    <div class="events-hero mb-4">
        <div class="events-hero-content">
            <span class="events-eyebrow">DISCOVER YOUR NEXT EXPERIENCE</span>

            <h1>Find events worth <span>showing up for.</span></h1>

            <p>
                Explore what's happening, connect with people, learn something new,
                and find your next memorable experience.
            </p>

            <div class="events-hero-meta">
                <span>
                    <span class="events-meta-dot"></span>
                    Discover what's happening
                </span>

                <span class="events-meta-divider">·</span>

                <span>One place for every event</span>
            </div>
        </div>

        <div class="events-hero-art" aria-hidden="true">
            <div class="events-art-circle events-art-circle-one"></div>
            <div class="events-art-circle events-art-circle-two"></div>

            <div class="events-calendar-art">
                <div class="events-calendar-top">
                    <span></span>
                    <span></span>
                </div>

                <div class="events-calendar-month">YOUR NEXT</div>
                <div class="events-calendar-title">Great<br />Experience</div>

                <div class="events-calendar-grid">
                    <span>01</span>
                    <span>02</span>
                    <span class="events-calendar-highlight">03</span>
                    <span>04</span>
                    <span>05</span>
                    <span>06</span>
                </div>
            </div>

            <div class="events-floating-note">
                <span class="events-floating-icon">✦</span>
                <span>
                    <strong>Make connections</strong>
                    <small>Memories start here</small>
                </span>
            </div>
        </div>

        @if (User.IsInRole("Organizer"))
        {
            <a asp-controller="Events"
               asp-action="Create"
               class="btn events-create-button">
                <span class="events-plus">+</span> Create an event
            </a>
        }
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show events-notice"
             role="alert">
            <strong>Success:</strong> @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show events-notice"
             role="alert">
            <strong>Notice:</strong> @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Search, status filter, and sorting -->
    <form asp-controller="Events"
          asp-action="Index"
          method="get"
          class="events-filter-panel">

        <div class="events-filter-heading">
            <div class="events-filter-heading-icon" aria-hidden="true">⌕</div>

            <div>
                <h3>Find your next event</h3>
                <p>Search, filter, and organize events your way.</p>
            </div>
        </div>

        <div class="events-filter-controls">

            <!-- Search field -->
            <div class="events-search-field">
                <label for="searchTerm">Search events</label>

                <div class="events-search-input-wrap">
                    <span class="events-search-icon" aria-hidden="true">⌕</span>

                    <input type="search"
                           id="searchTerm"
                           name="searchTerm"
                           value="@searchTerm"
                           class="form-control events-search-input"
                           placeholder="Search title, location, category..."
                           maxlength="100" />
                </div>
            </div>

            <!-- Status filter -->
            <div class="events-filter-field">
                <label for="status">Event status</label>

                <select id="status"
                        name="status"
                        class="form-select events-filter-select">

                    <option value="all"
                            selected="@(selectedStatus == "all")">
                        All statuses
                    </option>

                    <option value="upcoming"
                            selected="@(selectedStatus == "upcoming")">
                        Upcoming
                    </option>

                    <option value="full"
                            selected="@(selectedStatus == "full")">
                        Fully booked
                    </option>

                    <option value="past"
                            selected="@(selectedStatus == "past")">
                        Past events
                    </option>

                    <option value="cancelled"
                            selected="@(selectedStatus == "cancelled")">
                        Cancelled
                    </option>
                </select>
            </div>

            <!-- Sorting -->
            <div class="events-filter-field">
                <label for="sortBy">Sort results</label>

                <select id="sortBy"
                        name="sortBy"
                        class="form-select events-filter-select">

                    <option value="date-asc"
                            selected="@(selectedSort == "date-asc")">
                        Date: earliest first
                    </option>

                    <option value="date-desc"
                            selected="@(selectedSort == "date-desc")">
                        Date: latest first
                    </option>

                    <option value="title"
                            selected="@(selectedSort == "title")">
                        Event title: A–Z
                    </option>

                    <option value="status"
                            selected="@(selectedSort == "status")">
                        Event status
                    </option>
                </select>
            </div>

            <!-- Search and clear buttons -->
            <div class="events-filter-actions">
                <button type="submit" class="btn events-search-button">
                    Search events
                </button>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="events-clear-button">
                    Clear
                </a>
            </div>

        </div>
    </form>

    <!-- Results heading -->
    <div class="events-results-header">
        <div>
            <span class="events-section-eyebrow">EXPLORE</span>
            <h2>Discover events</h2>
            <p>Find the right experience for you.</p>
        </div>

        <div class="events-count">
            <span class="events-count-number">@resultCount</span>

            <span>
                of @totalEvents
                @(totalEvents == 1 ? "event" : "events")
            </span>
        </div>
    </div>

    <!-- Event listings -->
    @if (eventList.Any())
    {
        <div class="row g-4 events-grid">

            @foreach (var eventItem in eventList)
            {
                int registeredCount = eventItem.Registrations?
                    .Count(r => r.Status == "Registered") ?? 0;

                int remainingPlaces = Math.Max(
                    0,
                    eventItem.Capacity - registeredCount);

                bool isCancelled = eventItem.Status == "Cancelled";
                bool hasPassed = eventItem.EventDate <= DateTime.Now;
                bool isFull = registeredCount >= eventItem.Capacity;

                string statusLabel;
                string statusClass;

                if (isCancelled)
                {
                    statusLabel = "Cancelled";
                    statusClass = "event-status-cancelled";
                }
                else if (hasPassed)
                {
                    statusLabel = "Past event";
                    statusClass = "event-status-past";
                }
                else if (isFull)
                {
                    statusLabel = "Fully booked";
                    statusClass = "event-status-full";
                }
                else
                {
                    statusLabel = "Upcoming";
                    statusClass = "event-status-upcoming";
                }

                int capacityPercent = eventItem.Capacity > 0
                    ? Math.Min(
                        100,
                        (int)Math.Round(
                            (double)registeredCount / eventItem.Capacity * 100))
                    : 100;

                <div class="col-md-6 col-xl-4">
                    <article class="event-listing-card">

                        <!-- Card accent -->
                        <div class="event-card-accent"></div>

                        <div class="event-card-inner">

                            <!-- Category and status -->
                            <div class="event-card-labels">
                                <span class="event-category">
                                    @(eventItem.Category?.Name ?? "Uncategorized")
                                </span>

                                <span class="event-status @statusClass">
                                    <span class="event-status-dot"></span>
                                    @statusLabel
                                </span>
                            </div>

                            <!-- Date panel -->
                            <div class="event-date-panel">
                                <div class="event-date-icon" aria-hidden="true">
                                    <span class="event-date-day">
                                        @eventItem.EventDate.ToString("dd")
                                    </span>

                                    <span class="event-date-month">
                                        @eventItem.EventDate.ToString("MMM")
                                    </span>
                                </div>

                                <div class="event-date-details">
                                    <strong>
                                        @eventItem.EventDate.ToString("dddd, dd MMMM yyyy")
                                    </strong>

                                    <span>
                                        @eventItem.EventDate.ToString("h:mm tt")
                                    </span>
                                </div>
                            </div>

                            <!-- Event information -->
                            <h3 class="event-card-title">@eventItem.Title</h3>

                            <p class="event-card-description">
                                @eventItem.Description
                            </p>

                            <!-- Location -->
                            <div class="event-detail-line">
                                <span class="event-detail-icon" aria-hidden="true">⌖</span>
                                <span>@eventItem.Location</span>
                            </div>

                            <!-- Capacity and registrations -->
                            <div class="event-capacity-panel">
                                <div class="event-capacity-heading">
                                    <span>Attendee capacity</span>

                                    <strong>
                                        @registeredCount <span>/ @eventItem.Capacity</span>
                                    </strong>
                                </div>

                                <div class="event-capacity-track"
                                     role="progressbar"
                                     aria-label="Event registration capacity"
                                     aria-valuenow="@capacityPercent"
                                     aria-valuemin="0"
                                     aria-valuemax="100">

                                    <div class="event-capacity-fill @(isFull ? "event-capacity-full" : "")"
                                         style="width: @(capacityPercent)%;">
                                    </div>
                                </div>

                                @if (isCancelled)
                                {
                                    <p class="event-availability event-availability-danger">
                                        Registration is unavailable because this event was cancelled.
                                    </p>
                                }
                                else if (hasPassed)
                                {
                                    <p class="event-availability event-availability-muted">
                                        This event has already started or passed.
                                    </p>
                                }
                                else if (isFull)
                                {
                                    <p class="event-availability event-availability-warning">
                                        This event is fully booked.
                                    </p>
                                }
                                else
                                {
                                    <p class="event-availability">
                                        <strong>@remainingPlaces</strong>
                                        @(remainingPlaces == 1 ? "place" : "places") remaining
                                    </p>
                                }
                            </div>

                            <!-- Organizer -->
                            <div class="event-organizer">
                                <div class="event-organizer-avatar" aria-hidden="true">
                                    @if (eventItem.Organizer != null &&
                                         !string.IsNullOrWhiteSpace(eventItem.Organizer.FirstName))
                                    {
                                        @eventItem.Organizer.FirstName.Substring(0, 1).ToUpperInvariant()
                                    }
                                    else
                                    {
                                        <span>?</span>
                                    }
                                </div>

                                <div class="event-organizer-details">
                                    <span>Organized by</span>

                                    <strong>
                                        @if (eventItem.Organizer != null)
                                        {
                                            @($"{eventItem.Organizer.FirstName} {eventItem.Organizer.LastName}")
                                        }
                                        else
                                        {
                                            @:Unknown organizer
                                        }
                                    </strong>
                                </div>
                            </div>

                            <!-- Details action -->
                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@eventItem.EventId"
                               class="btn event-details-button">

                                View event details
                                <span aria-hidden="true">→</span>
                            </a>

                        </div>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty state -->
        <div class="events-empty-state">
            <div class="events-empty-icon" aria-hidden="true">✦</div>

            <span class="events-section-eyebrow">
                NOTHING TO SHOW YET
            </span>

            <h3>
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    @:No matching events found
                }
                else if (selectedStatus != "all")
                {
                    @:No events match this status
                }
                else
                {
                    @:No events available yet
                }
            </h3>

            <p>
                @if (!string.IsNullOrWhiteSpace(searchTerm) ||
                     selectedStatus != "all")
                {
                    @:Try a different search term or change your status filter to see more events.
                }
                else
                {
                    @:There are no events to display right now. Check back later for new experiences.
                }
            </p>

            @if (User.IsInRole("Organizer"))
            {
                <a asp-controller="Events"
                   asp-action="Create"
                   class="btn event-details-button events-empty-button">

                    Create your first event
                    <span aria-hidden="true">→</span>
                </a>
            }
        </div>
    }

</section>
